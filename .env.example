# Development template: copy to .env.development.local (ignored by Git).
# Create only if absent: test -e .env.development.local || cp .env.example .env.development.local
# VITE_* values are public browser configuration; never put secrets here.
# Restart Vite after edits. Shell environment variables take precedence.

# Vite development server. Open http://127.0.0.1:5173 with these values.
HOST=127.0.0.1
PORT=5173

# Empty uses /dev-api in development and /api in production builds.
# The development proxy strips /dev-api before forwarding to this target.
VITE_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Browser connects directly to the independent Socket.IO process.
# Leave empty to skip the default presence/notification connection.
# For another device, replace 127.0.0.1 with the server's reachable LAN IP.
VITE_SOCKET_URL=http://127.0.0.1:8001

# Optional external news service.
VITE_NEWS_URL=

# Exact string true shows /flow in the navigation; otherwise it shows /dev.
# This is a navigation switch, not an API authorization control.
VITE_IS_DEV_MODE=true
